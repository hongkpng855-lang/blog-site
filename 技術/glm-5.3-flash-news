<!-- JavaScript 資源 -->
<script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
// 響應式導航欄優化：移動端點擊菜單項後自動關閉
document.addEventListener('DOMContentLoaded', function() {
  const navLinks = document.querySelectorAll('.navbar-nav .nav-link:not(.dropdown-toggle)');
  const navbarCollapse = document.querySelector('.navbar-collapse');
  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (window.innerWidth < 992) {
        const bsCollapse = bootstrap.Collapse.getInstance(navbarCollapse);
        if (bsCollapse) bsCollapse.hide();
      }
    });
  });
});
</script>
<!-- 瀏覽計數（2026-10-11 起）匿名・每 session 一次・唔記任何個人資料 -->
<!-- 2026-10-20 加逐頁計數：全站一個 key + 每頁一個 key（key 由 path 雜湊，唔含個人資料） -->
<script>
(function () {
  try {
    var GLOBAL_KEY = 'anthroskill-org/pageviews';
    var PAGE_NS = 'anthroskill-pg';
    var BASE = 'https://abacus.jasoncameron.dev/hit/';

    if (sessionStorage.getItem('as_vc')) return;
    sessionStorage.setItem('as_vc', '1');
    if (navigator.webdriver) return;
    var ua = navigator.userAgent || '';
    if (/bot|crawl|spider|headless|preview|lighthouse|monitor|pagespeed/i.test(ua)) return;

    function beep(key) {
      var img = new Image();
      img.referrerPolicy = 'no-referrer';
      img.src = BASE + key + '?t=' + Date.now();
    }

    // 逐頁 key：可讀 slug（ASCII）+ FNV-1a 32-bit 雜湊，同 scripts/page-views-report.py 保持一致
    function canon(path) {
      // 統一成 canonical percent-encoding，瀏覽器同 Python 兩邊計出同一個字串
      try { return encodeURI(decodeURI(path)); } catch (e) { return path; }
    }

    function fnv1a(str) {
      var h = 0x811c9dc5;
      for (var i = 0; i < str.length; i++) {
        h ^= str.charCodeAt(i);
        h = (h + ((h << 1) + (h << 4) + (h << 7) + (h << 8) + (h << 24))) >>> 0;
      }
      return h >>> 0;
    }

    function pageKey() {
      var p = canon(location.pathname || '/');
      var body = p.replace(/^\/+|\/+$/g, '');
      if (!body) body = 'home';
      var slug = body.toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 40)
        .replace(/-+$/g, '');
      if (!slug) slug = 'p';
      var h = fnv1a(p).toString(36);
      return PAGE_NS + '/' + slug + '-' + h;
    }

    beep(GLOBAL_KEY);
    var pk = pageKey();
    if (/^[A-Za-z0-9_\-.]+$/.test(pk.split('/')[1])) beep(pk);
  } catch (e) {}
})();
</script>

</body>
